# Copy to .env (never commit .env). Production secrets live in GCP Secret Manager.

# LLM: anthropic | openai (openai also covers OpenAI-compatible endpoints via LLM_BASE_URL)
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
# USD per million tokens, copied from your provider's pricing page. 0 = cost not tracked.
LLM_PRICE_IN_PER_MTOK=0
LLM_PRICE_OUT_PER_MTOK=0
# Cheaper model for the benchmark's verification_cheap config
LLM_MODEL_CHEAP=
LLM_CHEAP_PRICE_IN_PER_MTOK=0
LLM_CHEAP_PRICE_OUT_PER_MTOK=0

# Sandbox: docker (local), http (sandbox service), none (SQL-only)
SANDBOX_MODE=docker
SANDBOX_IMAGE=datapilot-sandbox:latest
SANDBOX_URL=

# API
SAMPLES_ONLY=false
DAILY_QUESTION_LIMIT=15
# Whole-API daily caps (all clients together). Counters are in memory: keep 1 API instance.
GLOBAL_DAILY_QUESTION_LIMIT=300
DAILY_BUDGET_USD=5
# Uploads: per-client daily count and total stored bytes (24 h retention).
DAILY_UPLOAD_LIMIT=10
MAX_UPLOAD_DIR_MB=500
COST_CAP_USD=0.25
MAX_UPLOAD_MB=10
CORS_ORIGINS=http://localhost:3000
DATABASE_PATH=datapilot.sqlite3

# --- Free options (both use the OpenAI-compatible adapter) ---
# Gemini (key from https://aistudio.google.com/apikey):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=<a Gemini model id from your AI Studio model list>
# OpenRouter (key from https://openrouter.ai/keys):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=<a model id ending in :free from openrouter.ai/models>
